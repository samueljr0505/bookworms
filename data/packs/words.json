{
  "id": "words",
  "name": "Everyday Sentences",
  "description": "Word lists and sentence patterns from words.pdf: nouns, verbs in every tense, and 100 sentence shapes for 3rd-5th grade.",

  "pos": {
    "determiner":     { "label": "Little Word", "hint": "a, the, this, that, every", "color": "#9aa7d7" },
    "possessive":     { "label": "Whose Word", "hint": "tells whose it is: my, your, her", "color": "#aab8f0" },
    "adjective":      { "label": "Describing Word", "hint": "tells you what kind: big, sticky", "color": "#f2a65a" },
    "noun":           { "label": "Naming Word", "hint": "one person, place, or thing", "color": "#5ec4a3" },
    "mass":           { "label": "Stuff Word", "hint": "stuff, or lots of things: mud, berries - never after \"a\"", "color": "#4fb39a" },
    "name":           { "label": "Name", "hint": "a special name, with a capital letter", "color": "#8fd694" },
    "pronoun":        { "label": "Stand-in Word", "hint": "takes the place of a name: I, you, he, she, it, we, they", "color": "#b7d56b" },
    "objectPronoun":  { "label": "Me-Us Word", "hint": "a stand-in that comes after the action: me, us, them", "color": "#a5c75a" },
    "verbS":          { "label": "Does-It Word", "hint": "happening now, for he, she, it or one thing: hops, eats", "color": "#ef8f7d" },
    "baseVerb":       { "label": "Do-It Word", "hint": "plain action for I, you, we, they, or after a helper: hop, eat", "color": "#f4a3a0" },
    "verb":           { "label": "Did-It Word", "hint": "already happened: hopped, ate", "color": "#e9797a" },
    "ing":            { "label": "-ing Word", "hint": "keeps going, after am, is, are, was, were: hopping", "color": "#e58fc4" },
    "transitiveS":    { "label": "Does-It-To Word", "hint": "needs something after it, for he, she, it: builds", "color": "#f3a0b8" },
    "baseTransitive": { "label": "Do-It-To Word", "hint": "plain, and needs something after it: build", "color": "#f6b7c8" },
    "transitive":     { "label": "Did-It-To Word", "hint": "already happened, and needs something after it: built", "color": "#f08fa8" },
    "linking":        { "label": "Linking Word", "hint": "joins to a describing word: looked, felt", "color": "#d98bb5" },
    "be":             { "label": "Being Word", "hint": "am, is, are, was, were", "color": "#c48bd9" },
    "helper":         { "label": "Helper Word", "hint": "helps ask or tell: do, does, did, can, will", "color": "#a6a0e8" },
    "negative":       { "label": "No Word", "hint": "not, never, don't, can't", "color": "#8e8ad0" },
    "question":       { "label": "Question Word", "hint": "where, why, how, what", "color": "#7fb0c9" },
    "adverb":         { "label": "How Word", "hint": "tells how or where: slowly, fast, outside", "color": "#c79ae0" },
    "preposition":    { "label": "Where Word", "hint": "on, under, into, with", "color": "#72b6e8" },
    "time":           { "label": "Time Word", "hint": "yesterday, night, Saturday", "color": "#6fc7d8" },
    "conjunction":    { "label": "Joining Word", "hint": "and, but, or, so - joins two sentences", "color": "#e7c35a" },
    "subordinator":   { "label": "When or Why Word", "hint": "because, when, if, while, until", "color": "#d6a86c" },
    "interjection":   { "label": "Feeling Word", "hint": "wow", "color": "#ff9f6e" },
    "polite":         { "label": "Polite Word", "hint": "please", "color": "#ffc48a" },
    "comma":          { "label": "Comma", "hint": "a little pause: ,", "color": "#c9b48a" }
  },

