  "rules": {
    "thing":      "( determiner | possessive ) ( adjective ( , adjective )? )? noun",
    "someone":    "<thing> | name",
    "stuff":      "( 'the' | possessive )? adjective? mass",
    "object":     "<someone> | <stuff> | objectPronoun | 'you' | 'it'",
    "place":      "preposition ( <someone> | objectPronoun )",
    "extra":      "( adverb | <place> )?",

    "one":        "<someone> | 'he' | 'she' | 'it'",
    "many":       "'we' | 'you' | 'they' | <someone> 'and' <someone>",
    "iOrMany":    "'I' | <many>",
    "subject":    "<one> | <iOrMany>",

    "eitherBase": "'bake' | 'blow' | 'chew' | 'clean' | 'climb' | 'cook' | 'dig' | 'draw' | 'drive' | 'eat' | 'help' | 'kick' | 'knit' | 'learn' | 'melt' | 'paint' | 'play' | 'read' | 'ride' | 'ring' | 'roll' | 'search' | 'sing' | 'spin' | 'stop' | 'stretch' | 'visit' | 'wash' | 'write'",
    "eitherS":    "'bakes' | 'blows' | 'chews' | 'cleans' | 'climbs' | 'cooks' | 'digs' | 'draws' | 'drives' | 'eats' | 'helps' | 'kicks' | 'knits' | 'learns' | 'melts' | 'paints' | 'plays' | 'reads' | 'rides' | 'rings' | 'rolls' | 'searches' | 'sings' | 'spins' | 'stops' | 'stretches' | 'visits' | 'washes' | 'writes'",
    "eitherPast": "'baked' | 'blew' | 'chewed' | 'cleaned' | 'climbed' | 'cooked' | 'dug' | 'drew' | 'drove' | 'ate' | 'helped' | 'kicked' | 'knitted' | 'learned' | 'melted' | 'painted' | 'played' | 'rode' | 'rang' | 'rolled' | 'searched' | 'sang' | 'spun' | 'stopped' | 'stretched' | 'visited' | 'washed' | 'wrote'",
    "eitherIng":  "'baking' | 'blowing' | 'chewing' | 'cleaning' | 'climbing' | 'cooking' | 'digging' | 'drawing' | 'driving' | 'eating' | 'helping' | 'kicking' | 'knitting' | 'learning' | 'melting' | 'painting' | 'playing' | 'reading' | 'riding' | 'ringing' | 'rolling' | 'searching' | 'singing' | 'spinning' | 'stopping' | 'stretching' | 'visiting' | 'washing' | 'writing'",
    "doTo":       "baseTransitive | <eitherBase>",
    "doesTo":     "transitiveS | <eitherS>",
    "didTo":      "transitive | <eitherPast>",

    "do":         "baseVerb <extra> | <doTo> <object> <extra>",
    "does":       "verbS <extra> | <doesTo> <object> <extra>",
    "did":        "verb <extra> | <didTo> <object> <extra> | linking 'too'? adjective",

    "isNow":      "'I' 'am' | <one> 'is' | <many> 'are'",
    "wasThen":    "( 'I' | <one> ) 'was' | <many> 'were'",
    "going":      "ing <extra> | <eitherIng> <object> <extra>",
    "beWhat":     "'too'? adjective | <going> | <place>",

    "clauseNow":  "<one> <does> | <iOrMany> <do> | <isNow> <beWhat>",
    "clausePast": "<subject> <did> | <wasThen> <beWhat>",
    "clause":     "<clauseNow> | <clausePast>",

    "askDo":      "'does' <one> | 'do' <iOrMany> | ( 'did' | 'can' | 'will' ) <subject>",
    "askBe":      "'am' 'I' | ( 'is' | 'was' ) <one> | ( 'are' | 'were' ) <many>",

    "pastTime":   "'yesterday' | 'last' ( 'night' | 'week' | 'Saturday' | 'Sunday' | 'spring' | 'fall' )",
    "anyTime":    "'at' ( 'night' | 'noon' ) | 'on' ( 'Saturday' | 'Sunday' ) | 'in' 'the' ( 'morning' | 'spring' | 'fall' ) | 'every' ( 'day' | 'week' | 'morning' | 'night' )"
  },

  "patterns": [
    { "id": "simple-now", "name": "Simple sentence (now)", "weight": 3,
      "shape": "<one> verbS adverb? | <iOrMany> baseVerb adverb?" },
    { "id": "simple-past", "name": "Simple sentence (past)", "weight": 2,
      "shape": "<subject> verb adverb?" },

    { "id": "doing-to-now", "name": "Doing-to sentence (now)", "weight": 3,
      "shape": "<one> <doesTo> <object> adverb? | <iOrMany> <doTo> <object> adverb?" },
    { "id": "doing-to-past", "name": "Doing-to sentence (past)", "weight": 2,
      "shape": "<subject> <didTo> <object> adverb?" },
    { "id": "doing-to-where", "name": "Doing-to-where sentence",
      "shape": "<one> <doesTo> <object> <place> | <iOrMany> <doTo> <object> <place> | <subject> <didTo> <object> <place>" },

    { "id": "describing", "name": "Describing sentence", "weight": 2,
      "shape": "( <isNow> | <wasThen> ) 'too'? adjective | <subject> linking 'too'? adjective" },
    { "id": "is-a", "name": "Is-a sentence",
      "shape": "( 'I' ( 'am' | 'was' ) | <one> ( 'is' | 'was' ) ) <thing>" },
    { "id": "where-is", "name": "Where-is sentence",
      "shape": "( <isNow> | <wasThen> ) <place>" },

    { "id": "where-now", "name": "Where sentence (now)", "weight": 2,
      "shape": "<one> verbS <place> | <iOrMany> baseVerb <place>" },
    { "id": "where-past", "name": "Where sentence (past)", "weight": 2,
      "shape": "<subject> verb <place> <place>?" },
    { "id": "who-where", "name": "Where-in-the-subject sentence",
      "shape": "<thing> <place> ( verbS | <doesTo> <object> )" },

    { "id": "time-first", "name": "Time-first sentence", "weight": 2,
      "shape": "<pastTime> , <clausePast> | <anyTime> , <clause>" },
    { "id": "opener", "name": "Opener sentence",
      "shape": "( 'slowly' | 'outside' ) , <clause>" },
    { "id": "feeling", "name": "Feeling sentence", "end": ["!"],
      "shape": "interjection , <clause>" },

    { "id": "two-verbs", "name": "Two-action sentence",
      "shape": "<one> verbS 'and' verbS | <iOrMany> baseVerb 'and' baseVerb | <subject> verb 'and' verb" },
    { "id": "three-verbs", "name": "Three-action sentence",
      "shape": "<one> verbS , verbS , 'and' verbS | <iOrMany> baseVerb , baseVerb , 'and' baseVerb | <subject> verb , verb , 'and' verb" },
    { "id": "two-jobs", "name": "Two-job sentence",
      "shape": "<one> <doesTo> <object> 'and' <doesTo> <object> | <iOrMany> <doTo> <object> 'and' <doTo> <object> | <subject> <didTo> <object> 'and' <didTo> <object>" },
    { "id": "two-things", "name": "Two-thing sentence",
      "shape": "( <one> <doesTo> | <iOrMany> <doTo> | <subject> <didTo> ) <object> 'and' <object>" },
    { "id": "team", "name": "Team sentence",
      "shape": "<someone> 'and' <someone> ( <do> | <did> )" },
    { "id": "list", "name": "List sentence",
      "shape": "<someone> , <someone> , 'and' <someone> ( <do> | <did> )" },
    { "id": "want-to", "name": "Want-to sentence",
      "shape": "( <one> 'wants' | <iOrMany> 'want' | <subject> 'wanted' ) 'to' <do>" },

    { "id": "future", "name": "Future sentence",
      "shape": "<subject> 'will' 'not'? <do>" },
    { "id": "ing", "name": "Still-going sentence",
      "shape": "( <isNow> | <wasThen> ) <going>" },
    { "id": "negative", "name": "Not sentence",
      "shape": "<one> 'does' 'not' <do> | <iOrMany> 'do' 'not' <do> | <subject> ( 'did' 'not' | \"can't\" ) <do> | ( <isNow> | <wasThen> ) 'not' adjective" },
    { "id": "there-is", "name": "There-is sentence",
      "shape": "'there' ( 'is' | 'was' ) <thing> <place>?" },

    { "id": "compound", "name": "Joined sentence",
      "shape": "<clauseNow> , conjunction <clauseNow> | <clausePast> , conjunction <clausePast>" },
    { "id": "complex-first", "name": "When-or-why-first sentence",
      "shape": "subordinator <clauseNow> , <clauseNow> | subordinator <clausePast> , <clausePast>" },
    { "id": "complex-last", "name": "When-or-why-last sentence",
      "shape": "<clauseNow> subordinator <clauseNow> | <clausePast> subordinator <clausePast>" },

    { "id": "yes-no", "name": "Yes-or-no question", "end": ["?"],
      "shape": "<askDo> <do>" },
    { "id": "be-question", "name": "Is-it question", "end": ["?"],
      "shape": "<askBe> ( 'too'? adjective | <going> )" },
    { "id": "wh-question", "name": "Question-word question", "end": ["?"],
      "shape": "( 'where' | 'why' | 'how' ) <askDo> baseVerb" },
    { "id": "what-question", "name": "What question", "end": ["?"],
      "shape": "'what' <askDo> <doTo>" },
    { "id": "where-question", "name": "Where-is question", "end": ["?"],
      "shape": "'where' <askBe>" },

    { "id": "command", "name": "Command", "end": ["!", "."],
      "shape": "'please'? <do>" },
    { "id": "dont", "name": "Don't command", "end": ["!", "."],
      "shape": "( \"don't\" | 'never' ) <do>" },
    { "id": "lets", "name": "Let's sentence", "end": ["!", "."],
      "shape": "\"let's\" <do>" },
    { "id": "talking-to", "name": "Talking-to sentence", "end": ["!", "."],
      "shape": "name , 'please'? <do>" },

    { "id": "what-a", "name": "What-a exclamation", "end": ["!"],
      "shape": "'what' 'a' adjective noun" },
    { "id": "how-adj", "name": "How exclamation", "end": ["!"],
      "shape": "'how' adjective" }
  ],

  "punctuation": [
    { "mark": ".", "name": "period" },
    { "mark": "!", "name": "exclamation point" },
    { "mark": "?", "name": "question mark" }
  ]
}
