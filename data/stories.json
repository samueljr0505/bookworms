{
  "about": "Story-building. A story is 8 sentences, each with its own objective (`goals`, the same for every topic): introduce a character, describe the setting, introduce a problem, something unexpected, three that develop the story, and one that resolves the problem. A story idea is picked at random for each story; its `beats` give a few of the topic's words for each objective, and those come out on the board more often while that objective is up (js/board.js). `check` marks an objective the game can check from the words: `character` needs a person or animal as the subject, `setting` needs a place. The others are up to the player. Every word in `beats` must be a word of that topic (tools/test.js checks).",
  "goals": [
    {
      "id": "character",
      "label": "Introduce a character",
      "ask": "Who is the story about? Start with a person or an animal.",
      "part": "beginning",
      "check": "character"
    },
    {
      "id": "setting",
      "label": "Describe the setting",
      "ask": "Where does the story happen? Use a place word.",
      "part": "beginning",
      "check": "setting"
    },
    {
      "id": "problem",
      "label": "Introduce a problem",
      "ask": "Uh oh! What goes wrong?",
      "part": "middle"
    },
    {
      "id": "surprise",
      "label": "Something unexpected happens",
      "ask": "What surprise happens next?",
      "part": "middle"
    },
    {
      "id": "develop",
      "label": "Develop the story",
      "ask": "What does your character do about the problem?",
      "part": "middle"
    },
    {
      "id": "develop",
      "label": "Develop the story",
      "ask": "What happens next?",
      "part": "middle"
    },
    {
      "id": "develop",
      "label": "Develop the story",
      "ask": "Does it get better, or worse?",
      "part": "middle"
    },
    {
      "id": "resolve",
      "label": "Resolve the problem",
      "ask": "How is the problem solved? How does it end?",
      "part": "end"
    }
  ],
